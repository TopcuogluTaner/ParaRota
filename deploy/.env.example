# ParaRota production ortam değişkenleri — GERÇEK .env sunucuda üretilir, repo'ya KOYULMAZ.
# Sunucuda kopyala:  cp .env.example .env  && değerleri doldur (scriptler otomatik üretir).

# --- PostgreSQL ---
POSTGRES_DB=pararota
POSTGRES_USER=pararota
POSTGRES_PASSWORD=__GENERATE__

# --- Uygulama secret'ları (appsettings.json'daki düz metinlerin yerine) ---
JWT_SIGNING_KEY=__GENERATE__
AZURE_DI_APIKEY=__FILL_FROM_AZURE__

# --- Gemini (fiş OCR fallback — Azure kotası bitince devreye girer) ---
# Google AI Studio'dan ücretsiz key: https://aistudio.google.com/apikey
GEMINI_API_KEY=__FILL_FROM_GOOGLE_AI_STUDIO__
GEMINI_MODEL=gemini-2.5-flash-lite

# --- SMTP / Resend (giden mail) ---
# Resend SMTP relay: host smtp.resend.com, user "resend", password = Resend API key (re_...).
# Domain pararotam.com Resend'de verified (DKIM/SPF/MX). Gönderen verified domain'de olmalı.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=resend
SMTP_PASSWORD=__FILL_FROM_RESEND_API_KEY__
SMTP_SENDER_EMAIL=noreply@pararotam.com
SMTP_SENDER_NAME=ParaRota

# --- URL / CORS ---
WEB_BASE_URL=https://pararotam.com
WEB_ORIGIN_1=https://pararotam.com
WEB_ORIGIN_2=https://www.pararotam.com
