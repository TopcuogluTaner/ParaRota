{
  "expo": {
    "name": "ParaRotam",
    "slug": "pararota-mobile",
    "scheme": "pararota",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b2a"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.pararotam.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Fis okutmak icin kameraya erisim gerekli.",
        "NSPhotoLibraryUsageDescription": "Fisten harcama olusturmak icin fotograflara erisim gerekli.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.YOUR_GOOGLE_IOS_CLIENT_ID"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.pararotam.mobile",
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pararotam.com",
              "pathPrefix": "/accept-invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1b2a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1b2a",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fisten harcama olusturmak icin fotograflara erismemiz gerekiyor.",
          "cameraPermission": "Fisi okutmak icin kameraya erismemiz gerekiyor."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_GOOGLE_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli harcama kaydı için mikrofon kullanılır (bas-konuş)."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sesli harcama kaydı için mikrofon kullanılır.",
          "speechRecognitionPermission": "Konuşmanı yazıya dökmek için konuşma tanıma kullanılır."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "apiBaseUrl": "https://api.pararotam.com/api/v1",
      "signalrBaseUrl": "https://api.pararotam.com",
      "googleWebClientId": "YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com",
      "googleIosClientId": "YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com",
      "googleAndroidClientId": "YOUR_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "revenueCatIosKey": "",
      "revenueCatAndroidKey": ""
    },
    "owner": "YOUR_EXPO_USERNAME",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/YOUR_EAS_PROJECT_ID"
    }
  }
}
